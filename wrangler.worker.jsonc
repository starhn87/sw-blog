{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sw-blog-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "limits": { "cpu_ms": 1000 },
  "observability": { "enabled": false },
  "secrets": {
    "required": ["ANTHROPIC_API_KEY", "ADMIN_PASSWORD", "VAPID_PRIVATE_KEY", "VAPID_SUBJECT"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sw-blog-db",
    "database_id": "ccc1ea5a-cc5b-4507-b106-9b690908e540",
    "migrations_dir": "drizzle/migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "sw-blog-media" }],
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "blog-search" },
    { "binding": "RAG_VECTORIZE", "index_name": "rag-chunks" }
  ]
}
