{
  "name": "sw-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "predev": "pnpm build:indexes",
    "build:indexes": "tsx scripts/build-search-index.ts && tsx scripts/build-rag-chunks.ts && tsx scripts/build-codebase-summary.ts",
    "prebuild": "tsx scripts/check-mdx-alt.ts && pnpm build:indexes",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "workers:build": "opennextjs-cloudflare build --config wrangler.worker.jsonc",
    "workers:preview": "opennextjs-cloudflare preview --config wrangler.worker.jsonc",
    "cf:typegen": "wrangler types --config wrangler.worker.jsonc --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && tsx scripts/check-mdx-alt.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/typography": "^0.5.20",
    "@types/google.maps": "^3.65.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.21.0",
    "next": "16.3.4",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@next/bundle-analyzer": "^16.3.4",
    "@next/eslint-plugin-next": "^16.3.4",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/navermaps": "^3.9.2",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react": "^7.37.5",
    "postcss": "^8.5.23",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.128.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
